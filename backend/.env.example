# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the engine (Haiku keeps cost low for MVP).
FORGE_MODEL=claude-haiku-4-5-20251001

# Readiness score (0-100) a request must clear before it can be "Ready for dev".
READINESS_THRESHOLD=80

# SQLite path. On Railway, point this at the mounted volume, e.g. /data/forge.db
DATABASE_URL=sqlite:///./forge.db

# Comma-separated origins allowed by CORS (the frontend URL).
CORS_ORIGINS=http://localhost:5173

# Simple shared login for the MVP (two known users). Leave blank to disable.
SHARED_PASSWORD=
